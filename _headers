/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), geolocation=(), microphone=()

/account.html
  Cache-Control: no-store, max-age=0

/get-started.html
  Cache-Control: no-store, max-age=0

/auth/*
  Cache-Control: no-store, max-age=0

/config/*
  Cache-Control: no-store, max-age=0
